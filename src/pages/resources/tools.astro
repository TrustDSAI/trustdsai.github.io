---
import MainLayout from '../../layouts/main.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "../../components/ui/card";
import { Tool } from '../../components/Tool';
---

<MainLayout content={{ title: 'Tools | TrustDevSecAI' }}>
  <section class="container mx-auto py-8">
    <h1 class="text-4xl font-bold mb-8">Tools</h1>
    
    <div class="space-y-12">
      <p class="text-lg mb-8">
          Tools and technologies used throughout the research project.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Tool 1 -->
        <!-- <Tool
          title="Tool Name"
          description="Tool Description"
          link="#"
          tags={["Python", "Deep Learning", "Static Analysis"]}
         /> -->
        <Tool
          title="Container Vulnerability Scanner Comparison"
          description="Empirical dataset, analysis tooling, and documentation for an MSc dissertation comparing Trivy, Grype, and OSV-Scanner across nine container images in three risk groups. Results feed into a policy-as-code vulnerability gating layer (OPA/Rego) for CI/CD pipelines."
          link="https://github.com/TrustDSAI/scanner-comparison"
          tags={["DevSecOps", "CI/CD", "Container Security", "Vulnerability Scanning", "Policy as Code", "Docker", "Cybersecurity"]}
         />
      </div>
    </div>
  </section>
</MainLayout> 